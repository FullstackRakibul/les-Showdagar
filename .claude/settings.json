{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run lint*)",
      "Bash(npx nuxi *)",
      "Bash(npx shadcn-vue@latest *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },
  "model": "claude-sonnet-4-6",
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": true
}
