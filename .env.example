# API base URL — points to Nuxt server routes in dev, real backend in prod
NUXT_PUBLIC_API_BASE=/api

# RabbITic AI assistant
# Ollama host, read server-side only by /api/rabbitic/chat
OLLAMA_API_URL=http://192.168.61.41:11434/
# OLLAMA_API_URL=http://192.168.61.41:11434/
# RabbitIC (.NET) backend for auth + conversation history. Leave blank to run
# RabbITic in local-only mode (chat works, nothing is persisted server-side).
NUXT_PUBLIC_RABBITIC_API_URL=
NUXT_PUBLIC_RABBITIC_MODEL=llama3

# Payment (add real keys for production)
# STRIPE_PUBLIC_KEY=pk_test_...
# BKASH_APP_KEY=...
# BKASH_APP_SECRET=...
